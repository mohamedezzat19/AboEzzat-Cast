<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- VPN profiles contain private WireGuard keys. -->
        <exclude domain="sharedpref" path="abo_vpn_profiles.xml" />
        <exclude domain="file" path="vpn_profiles/" />
        <exclude domain="file" path="abo_vpn.conf" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer device-bound receiver secrets or private VPN keys. -->
        <exclude domain="sharedpref" path="AboEzzatSharePrefs.xml" />
        <exclude domain="sharedpref" path="abo_vpn_profiles.xml" />
        <exclude domain="file" path="vpn_profiles/" />
        <exclude domain="file" path="abo_vpn.conf" />
    </device-transfer>
</data-extraction-rules>
